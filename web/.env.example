# Gemini (https://aistudio.google.com/apikey). Leave empty to use the offline MockLlm.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# YouTube Data API v3 key (search only). Empty = mock tracks with no real playback.
YOUTUBE_API_KEY=

# ElevenLabs TTS. Empty = announcements fall back to browser speechSynthesis.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Public base URL guests scan (use your LAN IP or ngrok URL so phones can reach it)
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Groq (console.groq.com/keys): automatic backup when Gemini hits its quota. Text-only, dev/insurance use.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Presage Physiology API key (cloud pulse scans from the browser). Server-side only; never commit it.
PRESAGE_API_KEY=
